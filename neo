#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# neo -- one front end for building and running NeoSymbian. Everything runs in the pinned build image (images.sh);
# the host needs Docker (and fastboot for `flash`).
#
#   neo fetch                    fetch the pinned 2010 sources into src/            (fetch.sh)
#   neo rom                      build the 2010 user side (ARMv8-A AArch32)          (build.sh; SIS=a,b adds legacy's sis.lock packages on C:)
#   neo kernel [BOARD]           the AArch64 kernel image with the user side         (kernel: build-ekern.sh)
#   neo nkernsa [BOARD]          the nanokernel test image                           (kernel: build-kernel.sh)
#   neo qemu [SECS] [WHAT]       boot the qemu board's image on QEMU virt; WHAT = ekern (default) | kernel (nkernsa)
#                                (VNC=:N: its screen, touch and keys on 127.0.0.1:590N, e.g. VNC=:0 neo qemu 3600)
#   neo name                     a new build name (date + an invented animal) for NAME=   (tools/buildname.py)
#   neo diff NAME1 NAME2         what changed between two named builds (releases/NAME.txt), per repo
#   neo flash [BOARD]            fastboot-boot the board's image (RAM only) and keep its console log (phone.py)
#
# BOARD = a baseport/arm64/<BOARD>_variant in the kernel tree (qemu = default, bonito, sargo, fajita). KERNEL = the kernel checkout
# (default: ../kernel beside this repo). Passed into the image when set: DTB (a file; bonito also takes BONITO_DTB),
# USERSIDE, USBDEBUG (=1: USB debugging on at boot, for images without the UI; else Settings), USERROM_SKIP, AUTOFASTBOOT, CONSOLE, EMMC_C, ROFS, ROFS_CORE (a regex: more images in the core ROM, run in place), ROFS_INSTALL, TEL_DIAGNOSTICS (C7 synthetic modem-fault diagnostics), VERITY_BAD, NKSA_SCALE, NKSA_MAIN, NKSA_TESTS, NKSA_RWTRACE.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/images.sh"
VOLUME=${BUILD_VOLUME:-neosymbian-build}
KERNEL=$(cd "${KERNEL:-$HERE/../kernel}" && pwd)
cmd=${1:-help}; [ $# -gt 0 ] && shift

kdocker() {	# kdocker <script> [args]: run a kernel tool in the image, the kernel tree at /kernel, the user side at /s2010
	user=""; [ "$(uname -s)" = Linux ] && user="--user $(id -u):$(id -g)"
	env=""
	for v in USERSIDE USBDEBUG USERROM_SKIP AUTOFASTBOOT CONSOLE EMMC_C ROFS ROFS_CORE ROFS_INSTALL TEL_DIAGNOSTICS VERITY_BAD NKSA_SCALE NKSA_MAIN NKSA_TESTS NKSA_RWTRACE; do
		eval "val=\${$v:-}"; [ -n "$val" ] && env="$env -e $v=$val"
	done
	dtb=${DTB:-${BONITO_DTB:-}}; dmount=""
	if [ -n "$dtb" ]; then dtb=$(cd "$(dirname "$dtb")" && pwd)/$(basename "$dtb"); dmount="-v $dtb:/dtb:ro"; env="$env -e DTB=/dtb"; fi
	# shellcheck disable=SC2086
	docker run --rm $user -e BOARD="$BOARD" $env $dmount -v "$KERNEL:/kernel" -v "$VOLUME:/s2010:ro" -w /kernel \
		"$BUILD_IMAGE" sh "baseport/arm64/tools/$@"
}

pyrun() {	# python3 here, or in the build image when the host has none (atlas build pods)
	if command -v python3 >/dev/null 2>&1; then python3 -I "$@"; else
		user=""; [ "$(uname -s)" = Linux ] && user="--user $(id -u):$(id -g)"
		# shellcheck disable=SC2086
		docker run --rm $user -v "$HERE:$HERE" -v "$KERNEL:$KERNEL" "$BUILD_IMAGE" python3 -I "$@"; fi
}

case $cmd in
fetch)   exec sh "$HERE/fetch.sh" ;;
rom)     exec sh "$HERE/build.sh" ;;
kernel)  BOARD=${1:-qemu} kdocker build-ekern.sh
	# the image's manifest: the ROM's (build.sh) + the kernel commit + the image flags; commit it as releases/NAME.txt
	# when the image is installed
	flags=""; for v in USBDEBUG AUTOFASTBOOT EMMC_C ROFS ROFS_CORE ROFS_INSTALL; do eval "val=\${$v:-}"; [ -z "$val" ] || flags="$flags $v=$val"; done
	krev=$(git -c safe.directory='*' -C "$KERNEL" rev-parse --short=8 HEAD 2>/dev/null || echo unknown)
	# shellcheck disable=SC2086
	pyrun "$HERE/tools/buildname.py" kernel "$HERE/out/manifest.txt" "$krev" "$KERNEL/out/ekern-${1:-qemu}/manifest.txt" $flags \
		|| echo "neo: no image manifest (python3?)" >&2 ;;
name)    pyrun "$HERE/tools/buildname.py" name ;;
diff)    pyrun "$HERE/tools/buildname.py" diff "$@" ;;
nkernsa) BOARD=${1:-qemu} kdocker build-kernel.sh ;;
qemu)    what=${2:-ekern}; BOARD=qemu OUT=/kernel/out/$what-qemu
	t=""; [ -t 0 ] && t=-it	# interactive when run from a terminal (type into the serial console)
	# VNC=:N: QEMU listens inside the container, published on this host's localhost only (no password)
	vnc=""; [ -z "${VNC:-}" ] || vnc="-e VNC=$VNC -e VNC_LISTEN=0.0.0.0 -p 127.0.0.1:$((5900 + ${VNC#:})):$((5900 + ${VNC#:}))"
	# shellcheck disable=SC2086
	docker run --rm $t $vnc -e OUT="$OUT" -v "$KERNEL:/kernel" -w /kernel "$BUILD_IMAGE" \
		run-qemu.sh "${1:-60}" ;;	# NeoSymbian/neoqemu's, on the image's PATH
flash)   BOARD=${1:-bonito}
	exec python3 -I "$KERNEL/baseport/arm64/tools/phone.py" run "$KERNEL/out/ekern-$BOARD/boot.img" \
		--log "$KERNEL/out/ekern-$BOARD/phone.log" --secs "${SECS:-30}" --product "$BOARD" ${STAY:+--stay} ;;
*)       sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//'; [ "$cmd" = help ] ;;
esac
