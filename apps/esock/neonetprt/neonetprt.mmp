// NEONET.PRT -- ESOCK's KAfInet protocol module over NeoNet (docs wifi.md W5a): see neonetprt.cpp.

TARGET          neonet.prt
TARGETTYPE      dll
UID             0x10003D38 0xE0004007
SOURCEPATH      .
SOURCE          neonetprt.cpp
USERINCLUDE     . ../../neonet
DEFFILE         eabi/neonetu.def

#include <platform_paths.hrh>
OS_LAYER_SYSTEMINCLUDE_SYMBIAN

LIBRARY         euser.lib esock.lib esocksvr.lib insock.lib neonet.lib

CAPABILITY      ALL -TCB
